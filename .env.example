# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of origins allowed by CORS.
# Covers default Vite dev (5173) and preview (4173) ports.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Local data paths. Relative paths resolve from the repo root.
DATA_DIR=backend/data
STATE_DIR=backend/data/state
UPLOAD_DIR=backend/data/uploads
EXTRACTED_DIR=backend/data/extracted
INDEX_DIR=backend/data/index
AI_ACT_CORPUS_DIR=backend/data/corpus

# LLM provider API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=local

# vLLM server — any OpenAI-compatible self-hosted endpoint (vLLM, Ollama with OpenAI mode, etc.)
VLLM_BASE_URL=http://127.0.0.1:11434/v1
VLLM_API_KEY=ollama

# Per-agent model assignment. Format: provider:model-id
# Required for analysis/chat. Examples:
#   openai:gpt-4o-mini
#   anthropic:claude-haiku-4-5-20251001
#   vllm:llama3.1
#
# Document fact extraction — structured JSON extraction from uploaded docs.
DOCUMENT_FACT_AGENT_MODEL=
#
# AI-system definition assessment — Article 3(1) scope check.
AI_SYSTEM_AGENT_MODEL=
#
# Risk classification — prohibited / high-risk / limited / unclear.
RISK_CLASSIFICATION_AGENT_MODEL=
#
# Obligations and governance mapping — multi-section obligations output.
OBLIGATIONS_AGENT_MODEL=
#
# Critic / uncertainty review — catches unsupported claims and overconfidence.
CRITIC_AGENT_MODEL=
#
# Follow-up chat — conversational Q&A grounded in saved analysis.
CHAT_AGENT_MODEL=

# --- Frontend (consumed by the Lovable-supplied Vite app) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
